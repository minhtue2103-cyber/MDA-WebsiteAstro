---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/shared/ContactForm.astro';
import AuthorGeoBox from '../components/shared/AuthorGeoBox.astro';
import FaqAccordion from '../components/ui/FaqAccordion.astro';

const breadcrumbs = [
  { name: 'Trang chủ', url: '/' },
  { name: 'Đăng ký thử khóa học', url: '/dang-ky-thu-khoa-hoc/' },
];

const trialFaqs = [
  {
    question: "Buổi đánh giá năng lực và học thử 45 phút có mất phí không?",
    answer: "Hoàn toàn miễn phí. Đây là buổi làm việc chuyên môn 45 phút cùng Ms Jen Phạm (Chứng từ & Pháp lý) và Mr. Tuệ Phạm (Giải pháp AI) để kiểm tra bộ hồ sơ hiện tại trước khi bạn quyết định chọn lộ trình phù hợp."
  },
  {
    question: "Tôi cần chuẩn bị gì trước buổi làm việc thử nghiệm?",
    answer: "Nếu doanh nghiệp đã có sản phẩm hoặc bộ chứng từ mẫu (hợp đồng, Invoice, Packing List, L/C), hãy chuẩn bị sẵn để chuyên gia rà soát trực tiếp. Nếu bạn là người mới, chỉ cần chuẩn bị mục tiêu nghề nghiệp hoặc mặt hàng dự định xuất khẩu."
  },
  {
    question: "Buổi học thử diễn ra trực tiếp hay trực tuyến?",
    answer: "Bạn có thể chọn gặp trực tiếp tại văn phòng Công ty TNHH Thương mại MD AGRI (Tầng 1, 53/104 Trần Khánh Dư, P. Tân Định, Quận 1, TP.HCM) hoặc trao đổi trực tuyến qua Google Meet / Zoom."
  }
];

const ctaSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "Buổi Đánh Giá Năng Lực & Học Thử Nghiệp Vụ XNK - AI Nông Sản",
  "description": "Buổi làm việc 45 phút miễn phí đánh giá hồ sơ chứng từ, mã HS theo 6 quy tắc GRI và demo quy trình AI an toàn dữ liệu cùng Ms Jen Phạm & Mr. Tuệ Phạm.",
  "provider": {
    "@type": "Organization",
    "name": "Công ty TNHH Thương mại MD AGRI",
    "sameAs": "https://mekongdeltaagri.com"
  }
};
---

<BaseLayout
  title="Đăng Ký Học Thử & Đánh Giá Năng Lực XNK - AI Miễn Phí | MDA Hub"
  description="Đăng ký buổi làm việc 45 phút miễn phí cùng Ms Jen Phạm & Mr. Tuệ Phạm: rà soát bộ chứng từ thật, kiểm tra mã HS và chọn lộ trình học 1-1 hoặc In-house."
  schema={ctaSchema}
>
  <section class="section section--soft cta-hero-section">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        {breadcrumbs.map((b, i) => (
          <>
            {i > 0 && <span class="breadcrumb__separator">/</span>}
            {i === breadcrumbs.length - 1 ? (
              <span class="breadcrumb__current" aria-current="page">{b.name}</span>
            ) : (
              <a href={b.url}>{b.name}</a>
            )}
          </>
        ))}
      </nav>

      <div class="grid-2 cta-hero-grid">
        <div class="cta-hero-left">
          <h1 class="page-hero__title" style="margin-top: 8px;">
            Đăng ký đánh giá hồ sơ XNK và trải nghiệm học thử 45 phút
          </h1>
          <p class="lead page-hero__lead">
            Trao đổi trực tiếp cùng Ms Jen Phạm (Pháp lý &amp; Chứng từ) và Mr. Tuệ Phạm (Giải pháp AI) để xác định đúng điểm nghẽn và lộ trình đào tạo phù hợp quy mô của bạn.
          </p>

          <div class="values-list">
            <h3 class="values-title">4 Nội Dung Thực Hiện Ngay Trong Buổi Đánh Giá:</h3>
            <div class="value-item">
              <div class="value-icon"><i class="bi bi-file-earmark-check-fill"></i></div>
              <div>
                <strong>Rà soát chéo bộ chứng từ hiện tại:</strong>
              </div>
            </div>

            <div class="value-item">
              <div class="value-icon"><i class="bi bi-cpu-fill"></i></div>
              <div>
                <strong>Demo kiểm tra rào cản &amp; đối soát AI bảo mật:</strong>
              </div>
            </div>

            <div class="value-item">
              <div class="value-icon"><i class="bi bi-compass-fill"></i></div>
              <div>
                <strong>Phân định đúng lộ trình đào tạo:</strong>
              </div>
            </div>

          </div>
        </div>

        <div class="cta-hero-right">
          <ContactForm
            title="Đặt Lịch Buổi Đánh Giá 45 Phút Miễn Phí"
            subtitle="Điền thông tin ngắn gọn bên dưới. Đội ngũ MD AGRI sẽ liên hệ xác nhận lịch hẹn trong vòng 24 giờ."
            defaultService="trial"
            extendedMode={true}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-header text-center" style="max-width: 760px; margin-inline: auto; margin-bottom: 32px;">
        <span class="badge">Hội Đồng Cố Vấn MD AGRI</span>
        <h2 class="section-title">Chuyên gia trực tiếp đồng hành trong buổi tư vấn</h2>
        <p class="lead">
          Không qua nhân sự trung gian — hai chuyên gia đồng sáng lập trực tiếp lắng nghe bài toán và kiểm tra hồ sơ của bạn.
        </p>
      </div>

      <AuthorGeoBox extended={true} />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container" style="max-width: 820px;">
      <FaqAccordion items={trialFaqs} title="Câu Hỏi Thường Gặp Về Buổi Đánh Giá Năng Lực" renderSchema={true} />
    </div>
  </section>
</BaseLayout>

<style>
  .cta-hero-section {
    padding-block: 40px 60px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cta-hero-grid {
    align-items: start;
    gap: 48px;
  }

  @media (max-width: 992px) {
    .cta-hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .values-list {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .values-title {
    font-size: 1.15rem;
    color: var(--primary-deep);
    margin: 0 0 4px;
  }

  .value-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: #ffffff;
    padding: 14px 18px;
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }

  .value-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--primary-50);
    color: var(--primary-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .value-item strong {
    font-size: 0.95rem;
    color: var(--primary-deep);
    display: block;
    margin-bottom: 2px;
  }

  .value-item p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>

