---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialSection from '../components/shared/TestimonialSection.astro';
import TrainingGalleryPdf from '../components/shared/TrainingGalleryPdf.astro';
import ContactForm from '../components/shared/ContactForm.astro';
import FaqAccordion from '../components/ui/FaqAccordion.astro';
import HeroWave from '../components/ui/HeroWave.astro';

const heroSlides = [
  {
    image: '/media/mda-xnk-ai-11.webp',
    alt: 'Đào tạo Xuất khẩu Trái cây Việt Nam & Chuỗi cung ứng ĐBSCL - MDA Hub',
  },
  {
    image: '/media/mda-xnk-ai-3.webp',
    alt: 'Tuân thủ & Xác thực Tiêu chuẩn FDA, BICON, SPS bằng AI',
  },
  {
    image: '/media/mda-xnk-ai-6.webp',
    alt: 'Chiến lược AI Marketing Nông sản & Tối ưu hóa GEO Toàn cầu',
  },
  {
    image: '/media/mda-xnk-ai-8.webp',
    alt: 'Phân loại Mã HS theo 6 quy tắc GRI & Thông tư 85/2026/TT-BTC',
  },
];

const expertFaqs = [
  {
    question: "Làm thế nào để ứng dụng AI vào rà soát L/C và hợp đồng ngoại thương mà không lo ngại rò rỉ bí mật thương mại?",
    answer: "MDA Hub phân tách rõ hai giải pháp: với nhu cầu đào tạo nhân sự, chúng tôi hướng dẫn dùng Prompt Engineering trên tài khoản doanh nghiệp (Zero Data Retention); với nhu cầu tự động hóa nội bộ, đội ngũ Mr. Tuệ Phạm triển khai Middleware Local AI tích hợp Data Masking tại máy trạm để che tên đối tác, đơn giá FOB/CIF và số tài khoản trước khi đối soát theo UCP 600, ISBP 821 và Incoterms 2020."
  },
  {
    question: "Tại sao doanh nghiệp xuất khẩu trái cây sấy thăng hoa và nông sản chế biến thường gặp rủi ro phạt thuế hoặc ách tắc mã HS tại thị trường đích?",
    answer: "Trái cây tươi (Chương 08) và trái cây sấy thăng hoa có bổ sung đường hoặc phụ gia (thường chuyển sang Chương 20 hoặc 21) chịu mức thuế suất, quy tắc xuất xứ (PSR) và tiêu chuẩn kiểm dịch khác nhau. Sai lệch ở cấp phân nhóm 6 số theo 6 quy tắc GRI dễ dẫn đến truy thu thuế sau thông quan. Ms Jen Phạm hỗ trợ lập bảng thẩm định thành phần và hồ sơ Xác định trước mã HS trước khi xuất bến."
  },
  {
    question: "Doanh nghiệp SME hoặc hợp tác xã nông sản quy mô nhỏ (<5 người XNK) có tự chủ quy trình và ứng dụng AI được không?",
    answer: "Hoàn toàn khả thi nếu chuẩn hóa quy trình SOP trước khi tự động hóa. MDA thiết kế lộ trình may đo cho đội ngũ tinh gọn, giúp nhân sự rà soát chéo Invoice, Packing List, C/O (Form EUR.1, CPTPP), Phyto và Health Cert dưới cơ chế Human-in-the-Loop (AI gắn cờ ngoại lệ, con người kiểm duyệt cuối cùng) mà không cần thay thế phần mềm ERP sẵn có."
  },
  {
    question: "Chương trình Huấn luyện Thực chiến của MDA có điểm gì khác biệt so với các khóa học xuất nhập khẩu đại trà?",
    answer: "Học viên thực hành trực tiếp trên 10–15 bộ chứng từ sống của doanh nghiệp ngành nông sản (trái cây tươi, sấy thăng hoa, thủy sản). Chương trình tập trung vào kỹ năng Quản lý ngoại lệ: xử lý bất hợp lệ L/C theo ISBP 821, cài điều khoản phòng thủ chất lượng/độ ẩm trên Sales Contract và ứng dụng bộ Prompt kiểm tra chéo hồ sơ trước khi tàu chạy."
  },
  {
    question: "MDA Hub hỗ trợ doanh nghiệp tháo gỡ rào cản kỹ thuật BICON (Úc), FDA (Mỹ), Health Canada và SPS theo lộ trình nào?",
    answer: "Mỗi dự án doanh nghiệp bắt đầu bằng Giai đoạn Khảo sát 30 ngày (Discovery Phase) để rà soát mặt hàng, đối chiếu căn cứ pháp lý (Thông tư 85/2026/TT-BTC, 42/2026/TT-BCT, 110/2026/TT-BTC), kiểm tra tính đồng bộ giữa Phyto, Health Cert, NPN Health Canada với mã HS và bàn giao bảng kiểm (Checklist) hành động cho từng lô hàng."
  }
];
---

<BaseLayout
  title="Mekong Delta Agri (MDA Hub) | Đào tạo XNK Nông sản Thực chiến & Ứng dụng AI Chứng từ"
  description="Công ty TNHH Thương mại MD AGRI (MDA Hub) — Đào tạo XNK nông sản thực chiến 1-1 cùng Ms Jen Phạm, tư vấn mã HS, FDA/BICON/SPS và giải pháp Middleware Local AI bảo mật dữ liệu."
>
  <!-- SECTION 1: HERO & ĐỊNH VỊ HỆ SINH THÁI -->
  <section class="hero-section hero-section--bleed">
    <div class="hero-grid hero-grid--bleed">
      <div class="hero-left hero-bleed-left">
        <span class="badge">Công ty TNHH Thương mại MD AGRI &bull; TP.HCM</span>
        <h1 class="section-title hero-title">
          Đào tạo XNK nông sản thực chiến &amp; Ứng dụng AI kiểm soát rủi ro chứng từ
        </h1>
        <p class="lead hero-lead">
          <strong>MDA Hub</strong> đào tạo nghiệp vụ xuất nhập khẩu trên bộ chứng từ và chuyển giao giải pháp AI bảo mật cho doanh nghiệp nông sản Việt Nam. Dưới sự dẫn dắt của <strong>Ms Jen Phạm</strong> (Pháp lý &amp; Nghiệp vụ) và <strong>Mr. Tuệ Phạm</strong> (Công nghệ AI &amp; Vận hành), doanh nghiệp tự chủ xuất khẩu sang Mỹ, Úc, Canada và EU.
        </p>
        <div class="hero-cta-group">
          <a href="#contact-form-block" class="btn btn--secondary">
            <i class="bi bi-clipboard2-check"></i> Nhận Tư Vấn Lộ Trình
          </a>
          <a href="/dich-vu/" class="btn btn--outline">
            <i class="bi bi-arrow-right-circle"></i> Xem Các Gói Dịch Vụ
          </a>
        </div>
        <div class="hero-trust-strip" style="display: flex; flex-wrap: wrap; gap: 12px 20px; margin-top: 22px; font-size: 0.86rem; color: var(--primary-deep); font-weight: 600;">
          <span><i class="bi bi-people-fill"></i> 150+ Học viên &amp; DN thực chiến</span>
          <span><i class="bi bi-globe-americas"></i> 4 Thị trường (Mỹ, Úc, Canada, EU)</span>
          <span><i class="bi bi-stopwatch-fill"></i> 60s Đối soát chứng từ mẫu</span>
          <span><i class="bi bi-shield-lock-fill"></i> 100% Bảo mật Data Masking</span>
        </div>
      </div>

      <div class="hero-right hero-bleed-right">
        <div class="hero-slider hero-slider--full" id="heroSlider">
          <div class="hero-slides-wrapper" id="heroSlidesTrack">
            {heroSlides.map((slide, index) => (
              <div class={`hero-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                <div class="hero-slide__image-wrap hero-slide__image-wrap--full">
                  <img
                    src={slide.image}
                    alt={slide.alt}
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              </div>
            ))}
          </div>

          <div class="slider-dots slider-dots--floating" id="sliderDots">
            {heroSlides.map((_, i) => (
              <button
                type="button"
                class={`dot-btn ${i === 0 ? 'active' : ''}`}
                data-slide={i}
                aria-label={`Chuyển đến hình ảnh ${i + 1}`}
              ></button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <HeroWave animated={true} id="home" />
  </section>

  <!-- SECTION 2: 3 TRỤ CỘT GIẢI PHÁP B2B -->
  <section class="section section--white why-choose-section">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="section-title">Doanh nghiệp xuất khẩu nông sản giải quyết bài toán nào cùng MDA Hub?</h2>
        <p class="lead">
          Ba trụ cột kết hợp giữa thực chiến chứng từ cảng biển, tuân thủ pháp lý quốc tế và ứng dụng AI an toàn dữ liệu dành cho cá nhân và doanh nghiệp SME.
        </p>
      </div>

      <div class="grid-3 why-choose-grid">
        <div class="why-card">
          <div class="why-card__badge">
            <i class="bi bi-person-workspace"></i> Huấn Luyện 1-1 &amp; In-house
          </div>
          <h3 class="why-card__title">Đào Tạo Quy Trình Trên Chứng Từ Sống</h3>
          <p class="why-card__desc">
            Chương trình huấn luyện theo đặc thù mặt hàng xuất khẩu giúp học viên trực tiếp xử lý bộ chứng từ thật cùng Ms Jen Phạm.
          </p>
          <ul class="why-card__features">
            <li><i class="bi bi-check-circle-fill"></i> Rà soát Invoice, Packing List, B/L, L/C MT700</li>
            <li><i class="bi bi-check-circle-fill"></i> Xử lý ngoại lệ: trễ tàu, sửa B/L, kiểm hóa</li>
            <li><i class="bi bi-check-circle-fill"></i> 6–8 tuần · Kèm 1-1 · Cá nhân &amp; Chủ xưởng</li>
          </ul>
          <a href="/dich-vu/dao-tao-xnk-1-1/" class="why-card__link">
            Chi tiết đào tạo 1-1 <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        <div class="why-card why-card--highlight">
          <div class="why-card__badge">
            <i class="bi bi-cpu-fill"></i> AI &amp; Bảo Mật Chứng Từ
          </div>
          <h3 class="why-card__title">Đối Soát Chứng Từ Chéo Bằng AI An Toàn</h3>
          <p class="why-card__desc">
            Ứng dụng AI vào quy trình Doanh Nghiệp & giải pháp Middleware/Local AI tích hợp Data Masking trên hệ thống ERP hiện tại.
          </p>
          <ul class="why-card__features">
            <li><i class="bi bi-check-circle-fill"></i> Che tên buyer, giá FOB/CIF qua Data Masking</li>
            <li><i class="bi bi-check-circle-fill"></i> Phát hiện sai lệch theo UCP 600 &amp; ISBP 821</li>
            <li><i class="bi bi-check-circle-fill"></i> 4–6 tuần · In-house · Phòng XNK &amp; Kế toán</li>
          </ul>
          <a href="/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/ung-dung-ai-xnk/" class="why-card__link">
            Khám phá giải pháp AI XNK <i class="bi bi-arrow-right"></i>
          </a>
        </div>

        <div class="why-card">
          <div class="why-card__badge">
            <i class="bi bi-shield-check"></i> Pháp Lý &amp; Mã HS
          </div>
          <h3 class="why-card__title">Thẩm Định Mã HS &amp; Rào Cản FDA, BICON</h3>
          <p class="why-card__desc">
            Áp dụng 6 quy tắc GRI và cập nhật các thông tư thuế mới (85/2026/TT-BTC, 42/2026/TT-BCT, 110/2026/TT-BTC) để phòng tránh truy thu thuế và kẹt hàng cảng đến.
          </p>
          <ul class="why-card__features">
            <li><i class="bi bi-check-circle-fill"></i> Phân định mã HS nông sản tươi và chế biến</li>
            <li><i class="bi bi-check-circle-fill"></i> Khai báo chuẩn FDA (Mỹ), BICON (Úc), SPS</li>
            <li><i class="bi bi-check-circle-fill"></i> Thư viện tài liệu &amp; Checklist cập nhật</li>
          </ul>
          <a href="/blog/" class="why-card__link">
            Xem thư viện bài viết pháp lý <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: ĐỘI NGŨ CHUYÊN GIA & HỆ SINH THÁI DỊCH VỤ -->
  <section class="section section--soft">
    <div class="container">
      <div class="grid-2 expert-grid">
        <div class="expert-visual">
          <div class="expert-image-box">
            <img src="/media/mda-xnk-ai-7.webp" alt="Ms Jen Phạm và đội ngũ cố vấn XNK nông sản MDA Hub" width="600" height="420" loading="lazy" />
            <div class="floating-badge">
              <i class="bi bi-shield-fill-check"></i>
              <div>
                <strong>150+ Học Viên &amp; DN</strong>
                <span>Thị trường Mỹ, Úc, Canada, EU</span>
              </div>
            </div>
          </div>
        </div>

        <div class="expert-content">
          <span class="badge">Phân Vai Chuyên Gia Minh Bạch</span>
          <h2 class="section-title">Hai chuyên gia dẫn dắt trực tiếp từng mảng nghiệp vụ và công nghệ</h2>
          <p class="lead">
            Không qua trợ giảng trung gian — mọi lộ trình đào tạo và tư vấn tại MDA Hub đều được phân tách trách nhiệm rõ ràng giữa pháp lý thực chiến và công nghệ AI:
          </p>

          <ul class="program-list">
            <li>
              <div class="program-icon"><i class="bi bi-person-check-fill"></i></div>
              <div>
                <strong>Ms Jen Phạm (Pháp lý &amp; Nghiệp vụ XNK):</strong> Đồng sáng lập MD AGRI. Trực tiếp kèm 1-1 trên bộ chứng từ sống, xử lý L/C (UCP 600, ISBP 821), mã HS (6 quy tắc GRI) và kiểm dịch FDA/BICON/SPS.
              </div>
            </li>
            <li>
              <div class="program-icon"><i class="bi bi-cpu-fill"></i></div>
              <div>
                <strong>Mr. Tuệ Phạm (Công nghệ AI &amp; Vận hành):</strong> Đồng sáng lập MD AGRI. Phụ trách tư vấn doanh nghiệp (Hotline 0904.622.122), thiết kế luồng Middleware Local AI, Data Masking và chiến lược AI Marketing chuẩn GEO.
              </div>
            </li>
            <li>
              <div class="program-icon"><i class="bi bi-buildings-fill"></i></div>
              <div>
                <strong>Đào tạo In-house theo ngành hàng:</strong> Chuẩn hóa SOP liên phòng ban (Mua hàng – Chứng từ – Logistics – Sales B2B) cho doanh nghiệp nông sản tươi, sấy thăng hoa và đông lạnh.
              </div>
            </li>
          </ul>

          <div class="expert-cta">
            <a href="/gioi-thieu/" class="btn btn--outline" style="margin-right: 12px;margin-bottom:15px">
              Hồ Sơ Chuyên Gia &amp; Pháp Nhân
            </a>
            <a href="/dich-vu/" class="btn btn--primary">
              So Sánh Các Gói Dịch Vụ <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: QUY TRÌNH 30 NGÀY & GIẢI ĐÁP THỰC TẾ -->
  <section class="section section--white faq-section">
    <div class="container">
      <div class="faq-split-grid">
        <div class="faq-col-left">
          <span class="badge">Quy Trình Chuẩn B2B</span>
          <h2 class="section-title faq-col-left__title">Lộ trình 4 bước từ chẩn đoán hồ sơ đến làm chủ quy trình</h2>

          <div class="core-benefits-wrapper">
            <h3 class="core-benefits__title">
              <i class="bi bi-diagram-3-fill"></i> Quy trình triển khai MDA:
            </h3>
            <div class="ft-sub-benefits-list">
              <div class="ft-sub-benefit-item">
                <div class="ft-sub-benefit__icon">
                  <i class="bi bi-1-circle-fill"></i>
                </div>
                <div class="ft-sub-benefit__content">
                  <h4 class="ft-sub-benefit__heading">Kiểm tra BCT doanh nghiệp</h4>
                  <p class="ft-sub-benefit__desc">
                    Khảo sát 30 ngày với doanh nghiệp hoặc kiểm tra 1 bộ chứng từ thật với cá nhân để xác định điểm nghẽn chi phí ẩn.
                  </p>
                </div>
              </div>

              <div class="ft-sub-benefit-item">
                <div class="ft-sub-benefit__icon">
                  <i class="bi bi-2-circle-fill"></i>
                </div>
                <div class="ft-sub-benefit__content">
                  <h4 class="ft-sub-benefit__heading">Thiết kế giáo trình &amp; SOP</h4>
                  <p class="ft-sub-benefit__desc">
                    May đo module theo đúng mã HS, điều kiện Incoterms 2020 và thị trường mục tiêu (Mỹ, Úc, Canada, EU).
                  </p>
                </div>
              </div>

              <div class="ft-sub-benefit-item">
                <div class="ft-sub-benefit__icon">
                  <i class="bi bi-3-circle-fill"></i>
                </div>
                <div class="ft-sub-benefit__content">
                  <h4 class="ft-sub-benefit__heading">Huấn luyện thực chiến &amp; AI</h4>
                  <p class="ft-sub-benefit__desc">
                    Thực hành bóc tách chứng từ, viết Prompt 3 lớp kèm Data Masking và giữ nguyên tắc Human-in-the-Loop.
                  </p>
                </div>
              </div>

              <div class="ft-sub-benefit-item">
                <div class="ft-sub-benefit__icon">
                  <i class="bi bi-4-circle-fill"></i>
                </div>
                <div class="ft-sub-benefit__content">
                  <h4 class="ft-sub-benefit__heading">Đồng hành xử lý ngoại lệ</h4>
                  <p class="ft-sub-benefit__desc">
                    Hỗ trợ rà soát chéo khi phát sinh tình huống trễ tàu, tu chỉnh L/C hoặc kiểm tra sau thông quan.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="faq-col-right">
          <div class="faq-highlight-box">
            <i class="bi bi-patch-question-fill"></i>
            <p>
              <strong>Nguyên tắc triển khai tại MDA Hub:</strong> Mọi dự án doanh nghiệp đều bắt đầu bằng giai đoạn khảo sát thực tế 30 ngày để chuẩn hóa dữ liệu và quy trình SOP trước khi đưa công cụ AI vào vận hành. Chi phí được báo giá may đo dựa trên độ phức tạp của hồ sơ sau khảo sát.
            </p>
          </div>
          <FaqAccordion
            items={expertFaqs}
            title="5 Câu Hỏi Thường Gặp Từ Doanh Nghiệp Xuất Khẩu"
            renderSchema={true}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: THƯ VIỆN TÀI LIỆU TẬP TRUNG & ĐÁNH GIÁ THỰC TẾ -->
  <TrainingGalleryPdf />
  <TestimonialSection />

  <!-- SECTION 6: FORM TƯ VẤN NHÚNG TRỰC TIẾP TRÊN DOMAIN -->
  <section class="section section--gradient connect-section">
    <div class="container" style="max-width: 960px;">
      <ContactForm
        title="Nhận lộ trình đào tạo may đo — Phản hồi trong 24 giờ"
        subtitle="Chia sẻ mặt hàng xuất khẩu hoặc vướng mắc chứng từ của bạn. Đội ngũ MD AGRI sẽ liên hệ tư vấn trực tiếp, không qua trung gian."
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* =====================================================================
     HERO SECTION (Farm Table Style Bleed-Right & 45-degree diagonal pattern)
     ===================================================================== */
  .hero-section--bleed {
    padding-block: 0;
    background-color: #f8faf6;
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .hero-grid--bleed {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    min-height: 560px;
  }

  .hero-bleed-left {
    padding-left: max(var(--container-pad-x), calc((100% - var(--container-max)) / 2 + var(--container-pad-x)));
    padding-right: clamp(24px, 4vw, 56px);
    padding-top: clamp(48px, 6vw, 84px);
    padding-bottom: clamp(75px, 9vw, 115px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-title {
    margin-bottom: 20px;
  }

  .hero-lead {
    margin-bottom: 28px;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* Slider - Full height, No border, Bleeding to right edge */
  .hero-bleed-right {
    position: relative;
