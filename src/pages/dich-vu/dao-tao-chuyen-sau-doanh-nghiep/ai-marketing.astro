---
import InsidePageLayout from '../../../layouts/InsidePageLayout.astro';
import TestimonialSection from '../../../components/shared/TestimonialSection.astro';
import FaqAccordion from '../../../components/ui/FaqAccordion.astro';

const breadcrumbs = [
  { name: 'Trang chủ', url: '/' },
  { name: 'Dịch vụ', url: '/dich-vu/' },
  { name: 'Đào tạo doanh nghiệp', url: '/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/' },
  { name: 'AI Marketing', url: '/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/ai-marketing/' },
];

const subNavigation = [
  { name: 'Tổng quan dịch vụ', url: '/dich-vu/' },
  { name: 'Đào tạo 1-1', url: '/dich-vu/dao-tao-xnk-1-1/' },
  { name: 'Đào tạo Doanh nghiệp', url: '/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/' },
  { name: 'Ứng dụng AI XNK', url: '/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/ung-dung-ai-xnk/' },
  { name: 'AI Marketing', url: '/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/ai-marketing/', active: true },
];

const bluf = "Chương trình AI Marketing Nông sản Quốc tế của MD AGRI hướng dẫn đội ngũ Sales và Marketing xuất khẩu triển khai chiến lược Story Answering, chuẩn hóa dữ liệu kỹ thuật và cấu trúc nội dung để các công cụ tìm kiếm AI (ChatGPT, Perplexity, Gemini) trích dẫn chính xác năng lực nhà cung cấp tới người mua B2B.";

const courseSummary = {
  format: "Huấn luyện In-house thực hành trực tiếp trên website & tài sản số công ty",
  duration: "6 tuần (Kiểm toán nội dung + Triển khai chuẩn hóa B2B)",
  instructor: "Mr. Tuệ Phạm & Đội ngũ Chiến lược Nội dung B2B MD AGRI",
};

const faqs = [
  {
    question: "Doanh nghiệp đã chạy quảng cáo trên Alibaba hoặc Google Ads thì có cần tối ưu nội dung cho AI tìm kiếm không?",
    answer: "Có. Quảng cáo trả phí chỉ mang lại lượt truy cập khi còn ngân sách. Chuẩn hóa dữ liệu kỹ thuật, chứng chỉ (FDA, BRC, BICON) và câu trả lời trực diện giúp website trở thành nguồn tham chiếu tự nhiên khi nhà mua hàng hỏi các công cụ AI."
  },
  {
    question: "Tối ưu nội dung cho AI tìm kiếm có bắt buộc phải đập đi xây lại toàn bộ website không?",
    answer: "Không. Đội ngũ kỹ thuật chỉ cần bổ sung phần tóm tắt trực diện ở đầu trang sản phẩm, khai báo dữ liệu có cấu trúc JSON-LD (Organization, Product, FAQPage) và cung cấp tệp /llms.txt rõ ràng."
  },
  {
    question: "Kết quả đầu ra của khóa 6 tuần gồm những gì?",
    answer: "Doanh nghiệp nhận được bộ khung nội dung trả lời câu hỏi kỹ thuật của nhà nhập khẩu, cấu trúc dữ liệu chuẩn Schema.org, bộ mẫu email chào hàng B2B và quy trình tự cập nhật nội dung bằng AI."
  }
];
---

<InsidePageLayout
  title="AI Marketing Nông Sản Quốc Tế & Tối Ưu Tìm Kiếm B2B | MDA Hub"
  description="Đào tạo chiến lược Story Answering và chuẩn hóa dữ liệu kỹ thuật cho doanh nghiệp xuất khẩu nông sản B2B tiếp cận nhà mua hàng qua công cụ tìm kiếm AI."
  badge="Tiếp Thị Xuất Khẩu B2B"
  heroTitle="AI Marketing nông sản và chiến lược thu hút nhà mua hàng B2B quốc tế"
  lead="Chuẩn hóa hồ sơ năng lực kỹ thuật, chứng chỉ xuất khẩu và câu trả lời chuyên môn để nhà nhập khẩu Mỹ, Úc, Canada, EU dễ dàng tìm thấy và tin tưởng doanh nghiệp bạn."
  heroImage="/media/mda-xnk-ai-contact.webp"
  breadcrumbs={breadcrumbs}
  subNavigation={subNavigation}
  blufText={bluf}
  courseSummary={courseSummary}
  authorRole="tue-pham"
  showAuthor={false}
  showGallery={false}
  showTestimonials={false}
  showContactForm={true}
  defaultService="ai-marketing"
>
  <section>
    <h2>Vì sao website nông sản viết hay vẫn không có thư hỏi hàng B2B?</h2>
    <div style="overflow-x: auto; margin-block: 18px;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.92rem; text-align: left;">
        <thead>
          <tr style="background-color: var(--primary-deep); color: #ffffff;">
            <th style="padding: 12px 16px;">Cách Làm Website Truyền Thống</th>
            <th style="padding: 12px 16px;">Chuẩn Dữ Liệu B2B Tại MD AGRI</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--border-subtle);">
            <td style="padding: 12px 16px;">Viết lời giới thiệu chung chung ("chất lượng hàng đầu")</td>
            <td style="padding: 12px 16px;">Công bố rõ mã HS, độ ẩm, quy cách đóng gói, chứng chỉ FDA/BRC/PUC.</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--border-subtle); background-color: #fafcf8;">
            <td style="padding: 12px 16px;">Thiếu cấu trúc dữ liệu máy đọc được (JSON-LD, llms.txt)</td>
            <td style="padding: 12px 16px;">Khai báo đầy đủ thực thể pháp nhân, sản phẩm và FAQ để AI trích dẫn đúng.</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--border-subtle);">
            <td style="padding: 12px 16px;">Gửi email chào hàng hàng loạt bằng mẫu dịch máy thô cứng</td>
            <td style="padding: 12px 16px;">Cá nhân hóa theo thị trường đích và rào cản kiểm dịch của từng nước nhập khẩu.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>Bốn trụ cột triển khai trong 6 tuần huấn luyện In-house</h2>
    <div class="grid-2" style="margin-block: 24px;">
      <div class="card card--tint">
        <h3 style="font-size: 1.08rem; color: var(--primary-deep);"><i class="bi bi-chat-quote-fill"></i> Chiến lược Story Answering</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
          Chuyển hóa các câu hỏi kỹ thuật của nhà mua hàng (MRLs, chiếu xạ, mã HS, thời gian giao mẫu) thành bài viết trả lời trực diện.
        </p>
      </div>

      <div class="card card--tint">
        <h3 style="font-size: 1.08rem; color: var(--primary-deep);"><i class="bi bi-code-slash"></i> Dữ liệu có cấu trúc Schema.org</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
          Khai báo thực thể công ty, chứng nhận FDA/BICON/SPS và thông số sản phẩm giúp công cụ tìm kiếm hiểu chính xác năng lực.
        </p>
      </div>

      <div class="card card--tint">
        <h3 style="font-size: 1.08rem; color: var(--primary-deep);"><i class="bi bi-filetype-txt"></i> Chuẩn hóa tệp llms.txt &amp; Catalog</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
          Tổ chức danh mục sản phẩm nông sản rõ ràng, có nguồn trích dẫn minh bạch để trợ lý AI dễ tổng hợp và giới thiệu.
        </p>
      </div>

      <div class="card card--tint">
        <h3 style="font-size: 1.08rem; color: var(--primary-deep);"><i class="bi bi-envelope-paper-heart-fill"></i> Kịch bản chào hàng &amp; Phản hồi Inquiry</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
          Xây dựng bộ mẫu Cold Email và thư phản hồi đàm phán thương mại chuẩn văn phong B2B Bắc Mỹ, Úc và Châu Âu.
        </p>
      </div>
    </div>
  </section>

  <TestimonialSection
    title="Hiệu Quả Thực Tế Từ Doanh Nghiệp Xuất Khẩu"
    subtitle="Kết quả áp dụng Story Answering và chuẩn hóa thông số FDA trên website B2B."
    filterIndices={[2]}
  />

  <section>
    <FaqAccordion items={faqs} title="Câu Hỏi Thường Gặp Về AI Marketing Nông Sản" renderSchema={true} />
  </section>
</InsidePageLayout>
