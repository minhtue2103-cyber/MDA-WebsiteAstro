---
import InsidePageLayout from '../../layouts/InsidePageLayout.astro';
import FaqAccordion from '../../components/ui/FaqAccordion.astro';

const breadcrumbs = [
  { name: 'Trang chủ', url: '/' },
  { name: 'Dịch vụ', url: '/dich-vu/' },
];

const subNavigation = [
  { name: 'Tổng quan dịch vụ', url: '/dich-vu/', active: true },
  { name: 'Đào tạo 1-1', url: '/dich-vu/dao-tao-xnk-1-1/' },
  { name: 'Đào tạo Doanh nghiệp', url: '/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/' },
  { name: 'Ứng dụng AI XNK', url: '/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/ung-dung-ai-xnk/' },
  { name: 'AI Marketing', url: '/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/ai-marketing/' },
];

const bluf = "Công ty TNHH Thương mại MD AGRI (MDA Hub) cung cấp hai nhánh dịch vụ chính cho ngành nông sản: Đào tạo XNK Thực chiến 1-1 do Ms Jen Phạm trực tiếp kèm cặp cá nhân, và Đào tạo Chuyên sâu Doanh nghiệp (In-house) kết hợp giải pháp AI XNK & AI Marketing do Mr. Tuệ Phạm và Hội đồng Pháp lý triển khai.";

const serviceFaqs = [
  {
    question: "Cá nhân mới chuyển ngành và doanh nghiệp có bộ phận XNK riêng nên chọn gói nào?",
    answer: "Cá nhân, chủ xưởng mới bắt đầu xuất khẩu trực tiếp hoặc nhân sự chứng từ cần kèm sát từng bộ hồ sơ nên chọn gói Đào tạo XNK 1-1 (6–8 tuần). Doanh nghiệp đã có đội ngũ 5–15 nhân sự cần chuẩn hóa SOP liên phòng ban hoặc tích hợp AI đối soát chứng từ nên chọn gói In-house."
  },
  {
    question: "Chi phí các gói đào tạo doanh nghiệp và tích hợp AI được tính như thế nào?",
    answer: "Mọi dự án In-house và tích hợp AI đều bắt đầu bằng Giai đoạn Khảo sát 30 ngày (Discovery Phase) để đánh giá hiện trạng hồ sơ và dữ liệu. Chi phí được báo giá may đo dựa trên số lượng module, mặt hàng và mức độ tích hợp sau khảo sát."
  },
  {
    question: "MDA Hub có nhận làm dịch vụ khai thuê hải quan trọn gói không?",
    answer: "Không. Chúng tôi tập trung 100% vào đào tạo thực chiến, tư vấn tuân thủ (mã HS, FDA, BICON, SPS, L/C) và chuyển giao quy trình AI nội bộ để doanh nghiệp tự chủ năng lực, thay vì làm thay hoàn toàn."
  }
];
---

<InsidePageLayout
  title="Dịch Vụ Đào Tạo XNK Thực Chiến & Giải Pháp AI Doanh Nghiệp | MDA Hub"
  description="So sánh các gói đào tạo XNK 1-1 cho cá nhân và đào tạo In-house cho doanh nghiệp xuất khẩu nông sản: Ứng dụng AI chứng từ, mã HS và AI Marketing chuẩn GEO."
  badge="Hệ Sinh Thái Dịch Vụ MD AGRI"
  heroTitle="Dịch vụ đào tạo XNK thực chiến và giải pháp AI cho doanh nghiệp nông sản"
  lead="Chọn đúng lộ trình phù hợp với quy mô nhân sự và giai đoạn xuất khẩu của bạn, từ kèm cặp 1-1 trên chứng từ sống đến chuẩn hóa vận hành phòng XNK."
  heroImage="/media/mda-xnk-ai-916-3.webp"
  breadcrumbs={breadcrumbs}
  subNavigation={subNavigation}
  blufText={bluf}
  showAuthor={false}
  showGallery={false}
  showTestimonials={false}
  showContactForm={true}
>
  <section>
    <h2>Hai nhánh dịch vụ tách biệt cho cá nhân và doanh nghiệp xuất khẩu</h2>
    <p>
      Mỗi giai đoạn phát triển của doanh nghiệp nông sản đòi hỏi cách tiếp cận khác nhau. Thay vì gộp chung một giáo trình đại trà, MD AGRI tách rõ hai nhánh dịch vụ với chuyên gia phụ trách riêng biệt:
    </p>

    <div class="grid-2" style="margin-block: 24px;">
      <div class="card card--tint" style="border-top: 4px solid var(--primary-dark);">
        <div style="font-size: 26px; color: var(--primary-dark); margin-bottom: 8px;">
          <i class="bi bi-person-workspace"></i>
        </div>
        <h3 style="font-size: 1.2rem; color: var(--primary-deep); margin-bottom: 6px;">
          Đào Tạo XNK Thực Chiến 1-1
        </h3>
        <p style="font-size: 0.82rem; font-weight: 700; color: var(--primary-dark); margin-bottom: 10px;">
          Thực chiến · Chứng từ sống · Kèm riêng 1-1
        </p>
        <p style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 14px;">
          Ms Jen Phạm trực tiếp kèm từng học viên xử lý trọn bộ Invoice, Packing List, B/L, C/O và L/C MT700. Phù hợp cá nhân chuyển ngành và chủ xưởng xuất khẩu trực tiếp.
        </p>
        <p style="font-size: 0.84rem; color: var(--text-secondary); margin-bottom: 16px;">
          6–8 tuần · Online/Offline TP.HCM · Cá nhân &amp; Chủ xưởng
        </p>
        <a href="/dich-vu/dao-tao-xnk-1-1/" class="btn btn--outline" style="align-self: flex-start;">
          Xem chi tiết gói 1-1 &rarr;
        </a>
      </div>

      <div class="card card--tint" style="border-top: 4px solid var(--secondary);">
        <div style="font-size: 26px; color: var(--secondary); margin-bottom: 8px;">
          <i class="bi bi-buildings"></i>
        </div>
        <h3 style="font-size: 1.2rem; color: var(--primary-deep); margin-bottom: 6px;">
          Đào Tạo Chuyên Sâu Doanh Nghiệp (In-house)
        </h3>
        <p style="font-size: 0.82rem; font-weight: 700; color: var(--secondary); margin-bottom: 10px;">
          May đo SOP · Bảo mật AI · Đồng bộ phòng ban
        </p>
        <p style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 14px;">
          Khảo sát 30 ngày và huấn luyện trực tiếp trên hồ sơ công ty, kết hợp AI đối soát chứng từ (Mr. Tuệ Phạm) và pháp lý hải quan (Ms Jen Phạm).
        </p>
        <p style="font-size: 0.84rem; color: var(--text-secondary); margin-bottom: 16px;">
          4–12 tuần · Tại doanh nghiệp · Đội ngũ 5–15 nhân sự
        </p>
        <a href="/dich-vu/dao-tao-chuyen-sau-doanh-nghiep/" class="btn btn--secondary" style="align-self: flex-start;">
          Xem chi tiết gói In-house &rarr;
        </a>
      </div>
    </div>
  </section>

  <section>
    <h2>Bảng so sánh nhanh để chọn đúng gói dịch vụ trong 20 giây</h2>
    <div style="overflow-x: auto; margin-block: 20px;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.92rem; text-align: left;">
        <thead>
          <tr style="background-color: var(--primary-deep); color: #ffffff;">
            <th style="padding: 14px 16px;">Tiêu Chí So Sánh</th>
            <th style="padding: 14px 16px;">Đào Tạo XNK 1-1</th>
            <th style="padding: 14px 16px;">Đào Tạo Doanh Nghiệp (In-house)</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--border-subtle);">
            <td style="padding: 14px 16px; font-weight: 600;">Đối tượng áp dụng</td>
            <td style="padding: 14px 16px;">Cá nhân, người mới, chủ xưởng sản xuất</td>
            <td style="padding: 14px 16px;">Phòng XNK, Mua hàng, Kế toán &amp; Sales B2B (5–15 người)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--border-subtle); background-color: #fafcf8;">
            <td style="padding: 14px 16px; font-weight: 600;">Chuyên gia phụ trách</td>
            <td style="padding: 14px 16px;">Ms Jen Phạm trực tiếp kèm 1-1</td>
            <td style="padding: 14px 16px;">Ms Jen Phạm (Nghiệp vụ) &amp; Mr. Tuệ Phạm (AI &amp; Vận hành)</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--border-subtle);">
            <td style="padding: 14px 16px; font-weight: 600;">Hồ sơ thực hành</td>
            <td style="padding: 14px 16px;">10–15 bộ chứng từ sống + hồ sơ học viên</td>
            <td style="padding: 14px 16px;">100% hợp đồng, L/C và mã HS thật của công ty</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--border-subtle); background-color: #fafcf8;">
            <td style="padding: 14px 16px; font-weight: 600;">Nội dung công nghệ AI</td>
            <td style="padding: 14px 16px;">Bộ Prompt 3 lớp tra mã HS &amp; soát chứng từ</td>
            <td style="padding: 14px 16px;">Prompt Enterprise / Middleware Local AI + Data Masking</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--border-subtle);">
            <td style="padding: 14px 16px; font-weight: 600;">Đầu ra bàn giao</td>
            <td style="padding: 14px 16px;">Tự tin xử lý độc lập lô hàng đầu tiên</td>
            <td style="padding: 14px 16px;">Quy trình SOP chuẩn hóa, bộ Prompt nội bộ &amp; lộ trình tích hợp</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p style="font-size: 0.9rem; color: var(--text-secondary);">
      Muốn tham khảo trước các biểu mẫu và bài phân tích pháp lý? Xem tại <a href="/blog/" style="font-weight: 600; text-decoration: underline;">Thư viện bài viết &amp; Tài liệu XNK</a>.
    </p>
  </section>

  <section>
    <h2>Quy trình 4 bước tiếp nhận và thiết kế lộ trình tư vấn</h2>
    <div class="grid-2" style="margin-block: 20px;">
      <div class="card card--tint" style="padding: 18px 22px;">
        <h3 style="font-size: 1.05rem; color: var(--primary-deep); margin-bottom: 6px;">Bước 1: Tiếp nhận bài toán</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
          Bạn gửi thông tin mặt hàng và vướng mắc qua form trực tiếp bên dưới hoặc Zalo 0904.622.122.
        </p>
      </div>
      <div class="card card--tint" style="padding: 18px 22px;">
        <h3 style="font-size: 1.05rem; color: var(--primary-deep); margin-bottom: 6px;">Bước 2: Chẩn đoán sơ bộ (30 phút)</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
          Mr. Tuệ Phạm và Ms Jen Phạm đánh giá hiện trạng chứng từ, mã HS và mức độ sẵn sàng dữ liệu.
        </p>
      </div>
      <div class="card card--tint" style="padding: 18px 22px;">
        <h3 style="font-size: 1.05rem; color: var(--primary-deep); margin-bottom: 6px;">Bước 3: Đề xuất giáo trình may đo</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
          Chốt lộ trình học 1-1 hoặc kế hoạch khảo sát 30 ngày (Discovery Phase) cho doanh nghiệp.
        </p>
      </div>
      <div class="card card--tint" style="padding: 18px 22px;">
        <h3 style="font-size: 1.05rem; color: var(--primary-deep); margin-bottom: 6px;">Bước 4: Huấn luyện &amp; Đồng hành</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
          Triển khai đào tạo trên chứng từ sống và hỗ trợ kiểm tra chéo khi phát sinh lô hàng thật.
        </p>
      </div>
    </div>
  </section>

  <section>
    <FaqAccordion items={serviceFaqs} title="Câu Hỏi Thường Gặp Khi Chọn Gói Dịch Vụ" renderSchema={true} />
  </section>
</InsidePageLayout>
