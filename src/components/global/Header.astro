---
import SocialLinks from '../shared/SocialLinks.astro';
import BrandLogo from './BrandLogo.astro';
---

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <BrandLogo />

    <!-- Header Actions (Socials + Large Menu Toggle Button) -->
    <div class="header-actions">
      <div class="header-socials">
        <SocialLinks variant="header" />
      </div>

      <!-- Off-Canvas Toggle Button (Icon lớn, không text) -->
      <button
        id="open-drawer-btn"
        class="drawer-toggle-btn"
        aria-label="Mở menu điều hướng"
        title="Menu"
      >
        <i class="bi bi-list"></i>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
    transition: box-shadow var(--transition-fast), background-color var(--transition-fast);
  }

  .site-header.scrolled {
    box-shadow: var(--shadow-sm);
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    gap: 16px;
  }

  /* Logo */
  .site-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-logo__img {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(45, 94, 45, 0.12);
  }

  .site-logo__text {
    display: flex;
    flex-direction: column;
  }

  .site-logo__title {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 900;
    color: var(--primary-deep);
    line-height: 1.2;
    letter-spacing: 0.5px;
  }

  .site-logo__sub {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--secondary);
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .header-socials {
      display: none;
    }
  }

  /* Drawer Toggle - Bỏ border/background, vùng chạm >= 44px bám mép phải */
  .drawer-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 44px;
    min-height: 44px;
    background: transparent;
    border: none;
    color: var(--primary-deep);
    cursor: pointer;
    transition: color var(--transition-fast), transform var(--transition-fast);
    padding: 4px;
    line-height: 1;
  }

  .drawer-toggle-btn:hover {
    background: transparent;
    color: var(--secondary);
    border: none;
    transform: scale(1.1);
    box-shadow: none;
  }

  .drawer-toggle-btn i {
    font-size: 36px;
    line-height: 1;
    display: block;
  }
</style>

<script>
  function setupHeaderScroll() {
    const header = document.getElementById('site-header');
    if (!header) return;

    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    });
  }

  setupHeaderScroll();
  document.addEventListener('astro:page-load', setupHeaderScroll);
</script>
